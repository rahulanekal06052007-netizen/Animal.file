class Vehicle{
    void drive(){
        System.out.println("reparing vehicle");
    }
}
class Car extends Vehicle{
    @Override
    void drive(){
        System.out.println("repairing a car");
    }
}
public class Main
{
	public static void main(String[] args) {
	    Car c=new Car();
	    c.drive();
	    
	}
}

