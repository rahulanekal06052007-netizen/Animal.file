class Animal{
    void makeSound(){
        System.out.println("animal makes sound");
    }
}
class Cat extends Animal{
    @Override
    void makeSound(){
        System.out.println("cat bark");
    }
}
public class Main
{
	public static void main(String[] args) {
	    Cat c=new Cat();
	    c.makeSound();
	    
	}
}
